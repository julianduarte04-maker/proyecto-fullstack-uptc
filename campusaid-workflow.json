    {
      "parameters": {
        "resource": "message",
        "operation": "send",
        "sendTo": "={{ $json.body.email_institucional }}",
        "subject": "=CampusAid UPTC · Solicitud de {{ $json.clasificacion }} recibida (#{{ String($json.body.id).slice(0, 8) }})",
        "emailType": "html",
        "message": "=<div style=\"font-family:Arial,sans-serif;max-width:560px\"><h2 style=\"background:#0a0a0a;color:#f5c300;padding:14px 18px;margin:0\">CampusAid UPTC</h2><div style=\"border:1px solid #ddd;padding:18px\"><p>Hola <b>{{ $json.body.estudiante_nombre }}</b>,</p><p>Recibimos tu solicitud y fue enrutada a <b>{{ $json.coordinacion }}</b>.</p><ul><li><b>Trámite:</b> {{ $json.clasificacion }}</li><li><b>Asignatura / Laboratorio:</b> {{ $json.body.asignatura_o_lab }}</li><li><b>Código:</b> {{ $json.body.codigo_uptc }}</li><li><b>Estado:</b> {{ $json.body.estado || 'Pendiente' }}</li><li><b>Radicado:</b> #{{ String($json.body.id).slice(0, 8) }}</li></ul><p><b>Descripción:</b><br>{{ $json.body.descripcion }}</p><p style=\"color:#666;font-size:12px\">Puedes consultar el estado de tu trámite en el panel de CampusAid.</p></div></div>",
        "options": {
          "ccList": "={{ $json.coordinador_email }}",
          "appendAttribution": false
        }
      },
      "id": "b2000000-0000-4000-8000-000000000007",
      "name": "Notificar por correo",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [960, 200]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"status\": \"ok\", \"clasificacion\": $('Webhook CampusAid').item.json.body.tipo_tramite, \"id\": $('Webhook CampusAid').item.json.body.id } }}",
        "options": {
          "responseCode": 200
        }
      },
      "id": "b2000000-0000-4000-8000-000000000008",
      "name": "Responder OK",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [1180, 200]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"status\": \"error\", \"message\": \"El correo debe ser institucional (@uptc.edu.co).\" } }}",
        "options": {
          "responseCode": 400
        }
      },
      "id": "b2000000-0000-4000-8000-000000000009",
      "name": "Responder error",
      "type": "n8n-nodes-base.respondToWebhook",
